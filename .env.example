# All values stay on the server. Never put credentials in VITE_* variables.
PORT=3000
RALLY_MODE=simulation
# Optional; otherwise generated at first start in .data/control-key (mode 0600).
# CONTROL_KEY=use-a-long-random-local-password-at-least-24-characters
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BROADCASTER_ID=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/twitch/callback
# Explicit opt-in after broadcaster consent; sign in as that broadcaster.
TWITCH_CHANNEL_CONSENT=false
# Optional comma-separated Twitch numeric user IDs delegated dashboard control.
TWITCH_CONTROL_USER_IDS=
RETENTION_DAYS=7
