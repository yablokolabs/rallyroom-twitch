{
  "name": "rallyroom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12 <23 || >=24 <25" },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/apps/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "simulate": "tsx scripts/simulate.ts",
    "evaluate": "tsx scripts/evaluate.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
